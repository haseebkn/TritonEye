# Copy to .env; never commit credentials.
MOCK_INGEST=false
# Explicit --mock is the only credential-free synthetic ingestion mode.
COPERNICUS_USER=
COPERNICUS_PASS=
# Free account: https://dataspace.copernicus.eu
# TARGET_DATE=2026-08-17
# AOI_NAME=grand_banks
# Other AOIs: st_johns_offshore, eastern_newfoundland, labrador_shelf.
# MOCK_INGEST_TIMESTAMP=20260801T120000

# Default: pinned xView3 ensemble; download via README instructions.
# TRITONEYE_DETECTOR=xview3
# XVIEW3_WEIGHTS=models/xview3/traced_ensemble.jit
# TRITONEYE_XVIEW3_THRESHOLD=0.15

# Optional experimental SAR-only YOLO backend. No generic-model fallback.
HUGGINGFACE_HUB_TOKEN=
HUGGINGFACE_MODEL_REPO=MeWan2808/yolov8n-sar-vessel-detection
HUGGINGFACE_MODEL_FILE=unquantized/best.pt
# HUGGINGFACE_MODEL_REVISION=
# YOLO_WEIGHTS=
# YOLO_WEIGHTS_SHA256=

# Live, incomplete AIS observations; no historical backfill.
# Free key: https://aisstream.io
AISSTREAM_API_KEY=

# SQLite default is local mlflow.db; shared server is optional.
# MLFLOW_TRACKING_URI=http://localhost:5000
# TRITONEYE_TRACKING=off
