# TritonEye configuration — copy to .env and fill in.
# .env is gitignored; never commit real credentials.

# ---------------------------------------------------------------- ingestion
# 'true' runs entirely offline against deterministic synthetic data.
# 'false' connects to the live Copernicus Data Space Ecosystem.
MOCK_INGEST=false

# Copernicus Data Space Ecosystem account (free registration at
# https://dataspace.copernicus.eu). Required when MOCK_INGEST=false.
COPERNICUS_USER=
COPERNICUS_PASS=

# Which acquisition to process.
#   TARGET_DATE  YYYY-MM-DD. If unset, ingest iterates the ais-YYYY-MM-DD
#                directories present under data/raw/ rather than fetching the
#                newest scene — set it explicitly to target one acquisition.
#   AOI_NAME     a file in configs/aois/ (without .geojson)
# TARGET_DATE=2025-01-08
# AOI_NAME=boston_offshore

# Pins the synthetic scene's timestamp so mock runs are reproducible.
# MOCK_INGEST_TIMESTAMP=20260708T050000

# ------------------------------------------------------------------ detector
# Weights are pulled from Hugging Face Hub, falling back to a local file and
# then to stock yolov8m.pt. Token only needs read scope.
HUGGINGFACE_HUB_TOKEN=
HUGGINGFACE_MODEL_REPO=MeWan2808/yolov8n-sar-vessel-detection
HUGGINGFACE_MODEL_FILE=unquantized/best.pt

# Runs the real detector against synthetic imagery (normally mock data uses the
# threshold-based stub detector instead).
# FORCE_REAL_INFERENCE=false

# Detection backend: 'yolov8' or 'xview3'. Overrides inference.detector.
# TRITONEYE_DETECTOR=xview3

# xView3 objectness threshold. Overrides inference.xview3_threshold, so an
# operating-point sweep can vary it per run without editing tracked config.
# TRITONEYE_XVIEW3_THRESHOLD=0.05

# ----------------------------------------------------------------------- AIS
# aisstream.io live global AIS feed, used by agents/ais_recorder.py to build a
# local archive at data/raw/ais_stream/. Free, GitHub sign-in, no organization
# required: https://aisstream.io
#
# Note: aisstream.io has no historical API. The recorder only captures AIS from
# the moment it starts, so run it well ahead of the acquisitions you intend to
# validate. It cannot backfill imagery already on disk.
AISSTREAM_API_KEY=

# ------------------------------------------------------------------ tracking
# Defaults to a repo-local SQLite database (mlflow.db). Point at a shared
# tracking server for team use. A file store will NOT work — MLflow 3 refuses
# it, and the model registry requires a database backend.
# MLFLOW_TRACKING_URI=http://localhost:5000

# Set to 'off' to disable experiment tracking entirely. Tracking failures are
# already non-fatal; this simply skips the work.
# TRITONEYE_TRACKING=on
